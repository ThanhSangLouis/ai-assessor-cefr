{
  "title": "AI Assessor CEFR — vận hành",
  "uid": "aicefr-ops",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "aicefr",
    "D051"
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "Yêu cầu HTTP mỗi giây theo mã trạng thái",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(aicefr_http_request_seconds_count[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Độ trễ HTTP p95 theo route (top 10)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.95, sum by (le,route) (rate(aicefr_http_request_seconds_bucket[5m]))))",
          "legendFormat": "{{route}}"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Thời gian từng bước pipeline p50 / p95",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le,stage) (rate(aicefr_pipeline_stage_seconds_bucket[5m])))",
          "legendFormat": "p50 {{stage}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le,stage) (rate(aicefr_pipeline_stage_seconds_bucket[5m])))",
          "legendFormat": "p95 {{stage}}"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Thời gian xử lý một việc chấm p50 / p95 (cơ sở tính giá một lượt)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le,purpose) (rate(aicefr_job_seconds_bucket[5m])))",
          "legendFormat": "p50 {{purpose}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le,purpose) (rate(aicefr_job_seconds_bucket[5m])))",
          "legendFormat": "p95 {{purpose}}"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Thời gian chờ trong hàng đợi chấm p95",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,purpose) (rate(aicefr_job_queue_wait_seconds_bucket[5m])))",
          "legendFormat": "{{purpose}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Việc chấm theo kết cục mỗi phút",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(aicefr_job_seconds_count[5m])) * 60",
          "legendFormat": "{{outcome}}"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Bài nộp mỗi phút",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(aicefr_submissions_total[5m])) * 60",
          "legendFormat": "bài nộp"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Lượt đã thu và đã hoàn mỗi giờ (kênh tính lượt)",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (rate(aicefr_metering_units_total[1h])) * 3600 / 10",
          "legendFormat": "{{state}}"
        }
      ],
      "id": 8
    }
  ]
}
