%% ERD - các collection sau D060, D075, D078, D081..D085, D088..D090 (lược đồ phiên bản 19): một aggregate root
%% của sơ đồ lớp là một collection; phần hợp thành nằm trong document của gốc
%% và được ghi bằng trường kiểu mảng. Đường liền: tham chiếu trong cùng một
%% database; đường nét đứt: tham chiếu sang database khác (D051) hoặc qua
%% account_id, không có khoá ngoại do kho ép. Chỉ ghi khoá và vài trường chính.
erDiagram
    account ||--o{ session : "đăng nhập"
    account ||--o{ push_subscription : "nhận thông báo (D088)"
    account ||--o{ response : "nộp"
    account ||--o{ classroom : "dạy, học"
    account ||..o{ attempt : "luyện"
    account ||..o{ review_item : "ôn"
    account ||..o{ word_drill : "luyện lại từ (D089)"
    account ||..o{ achievement : "đạt"
    account ||..o{ learning_plan : "nhận gợi ý"
    account ||..o| wallet : "ví lượt"
    account ||--o{ order : "mua"

    task ||--o{ response : "đề của"
    response ||--o| review_session : "việc duyệt (D082)"

    path ||--o{ lesson : "chặng gồm bài"
    lesson ||--o{ attempt : "lượt nói"
    lesson |o--o{ review_item : "ôn"
    response ||..o{ word_drill : "từ máy nghe chưa rõ"
    word_drill |o--o| review_item : "đưa vào ôn"
    account ||..o{ drill_passage : "đọc đoạn văn (D090)"
    drill_passage }o--|{ word_drill : "viết quanh 3-5 từ"
    learning_plan }o--o{ lesson : "gợi ý"
    learning_plan |o--o| path : "lưu thành"

    order ||--|| payment : "thanh toán (D084)"
    wallet ||--o{ ledger : "bút toán"
    ledger ||..|| response : "tính lượt cho"

    account {
        string account_id PK
        string pseudonym UK
        string role
        array identities "liên kết Google (băm)"
        object seen_markers
    }
    session {
        string token_hash PK
        string account_id
        string expires_at
    }
    push_subscription {
        string endpoint PK
        string account_id
    }
    task {
        string task_id PK
        string band
        int active
    }
    response {
        string response_id PK
        string account_id
        string task_id
        string status
        float overall_0_6
        string overall_band
        array reviews "Review"
        array replay_labels
    }
    review_session {
        string response_id UK
        object lock
        array visits
    }
    classroom {
        string class_id PK
        array teacher_ids
        array members
    }
    path {
        string path_id PK
        string status
        int built_in "D085"
        array units "Unit"
    }
    lesson {
        string lesson_id PK
        string unit_id
        int published_version
        array versions
        array media
    }
    attempt {
        string attempt_id PK
        string account_id
        string lesson_id
        int lesson_version
    }
    review_item {
        string item_id PK
        string account_id
        string due_date
        string drill_id "D089, rỗng với từ của bài học"
    }
    word_drill {
        string drill_id PK
        string account_id
        string response_id
        string word
        int streak
        bool passed
        array takes "lượt nói lại, tối đa 20"
    }
    drill_passage {
        string passage_id PK
        string account_id
        array drill_ids "3-5 từ đang luyện dở"
        string text
        string source "model hoặc phrases"
        array takes "lần đọc, tối đa 20"
    }
    achievement {
        string account_id PK
        string code PK
    }
    learning_plan {
        string plan_id PK
        string account_id
        string audience
        string path_id
    }
    order {
        string order_id PK
        string kind
        string status
        int runs
    }
    payment {
        string order_id UK
        string gateway
        string checkout_ref
        array events
    }
    wallet {
        string user_ref PK
        int balance
        int free_used
        array grants
    }
    ledger {
        string entry_id PK
        string key UK "bài nói"
        string action
        string state
    }
