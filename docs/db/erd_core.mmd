%% ERD - các collection sau D060 (lược đồ phiên bản 7): một aggregate root
%% của sơ đồ lớp là một collection; phần hợp thành nằm trong document của gốc
%% và được ghi bằng trường kiểu mảng. Đường liền: tham chiếu trong cùng một
%% database; đường nét đứt: tham chiếu sang database khác (D051) hoặc qua
%% account_id, không có khoá ngoại do kho ép. Chỉ ghi khoá và vài trường chính.
erDiagram
    account ||--o{ session : "đăng nhập"
    account ||--o{ response : "nộp"
    account ||--o{ classroom : "dạy, học"
    account ||..o{ attempt : "luyện"
    account ||..o{ review_item : "ôn"
    account ||..o{ achievement : "đạt"
    account ||..o{ learning_plan : "nhận gợi ý"
    account ||..o| wallet : "ví lượt"
    account ||--o{ order : "mua"

    task ||--o{ response : "đề của"
    rating_batch }o--o{ response : "phiếu chấm mù"
    study }o--o{ account : "người tham gia"
    classroom }o--o{ task : "bài giao"

    path ||--o{ lesson : "chặng gồm bài"
    lesson ||--o{ attempt : "lượt nói"
    lesson ||--o{ review_item : "ôn"
    learning_plan }o--o{ lesson : "gợi ý"
    learning_plan |o--o| path : "lưu thành"

    order |o--o| license : "mua"
    wallet ||--o{ ledger : "bút toán"
    ledger ||..|| response : "tính lượt cho"

    account {
        string account_id PK
        string pseudonym UK
        string role
        string terms_accepted_at
        array identities "liên kết Google (băm)"
        object seen_markers
    }
    session {
        string token_hash PK
        string account_id
        string expires_at
    }
    task {
        string task_id PK
        string purpose
        string band
    }
    response {
        string response_id PK
        string account_id
        string task_id
        string status
        float overall_0_6
        string overall_band
        array reviews "Review"
        object review_lock
        array review_visits
        array replay_labels
        array machine_seen
    }
    rating_batch {
        string batch_id PK
        bool closed
        array ratings "Rating: phiếu và điểm"
    }
    study {
        string study_id PK
        string status
        array participants "Participant kèm khảo sát"
    }
    classroom {
        string class_id PK
        string code UK
        string teacher_id
        array members
        array assignments "Assignment"
    }
    path {
        string path_id PK
        string status
        array units "Unit"
    }
    lesson {
        string lesson_id PK
        string unit_id
        int published_version
        array versions
        array media
    }
    attempt {
        string attempt_id PK
        string account_id
        string lesson_id
        int lesson_version
    }
    review_item {
        string item_id PK
        string account_id
        string due_date
    }
    achievement {
        string account_id PK
        string code PK
    }
    learning_plan {
        string plan_id PK
        string account_id
        string audience
        string path_id
    }
    order {
        string order_id PK
        string kind
        string status
        array events
    }
    license {
        string license_id PK
        string plan
        string order_id
    }
    wallet {
        string user_ref PK
        int balance
        int free_used
        array grants
    }
    ledger {
        string entry_id PK
        string key UK "bài nói"
        string action
        string state
    }
