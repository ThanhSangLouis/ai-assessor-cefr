@startuml 02b_kien_truc
!include _style.iuml

title Kiến trúc tổng thể — ba dịch vụ, bus và kho dữ liệu

' =====================================================================
'  Hinh nay tra loi: he thong chia thanh nhung dich vu nao, moi dich vu
'  lam gi, chung noi voi nhau the nao, du lieu nam o dau. Cong va bo
'  chuyen doi (cho cam ra ben ngoai) o hinh 02c; container va volume o
'  hinh 06. Ten trong ngoac la lop co that trong ma.
' =====================================================================

skinparam componentStyle rectangle
skinparam nodesep 35
skinparam ranksep 50
skinparam ComponentBackgroundColor #F7F1E3
skinparam ComponentBorderColor #A68A64
skinparam PackageBorderColor #8A94A6
skinparam DatabaseBackgroundColor #FBE3E4
skinparam QueueBackgroundColor #DCE8FA
skinparam CloudBackgroundColor #EEF2F8

actor "Sinh viên, giảng viên,\nquản trị viên" as User
node "gateway (nginx)\nmột địa chỉ duy nhất ra ngoài" as GW

package "web" as Web {
  component "Trang và số đếm thanh bên\n(gọi core qua RemoteFacade)" as Pages
}

package "core — mỗi phần một facade" as Core {
  component "identity\ntài khoản, đồng thuận\n(IdentityFacade)" as Identity
  component "assessment\nbài nộp, duyệt, đề theo band,\nlớp học, nghe lại\n(AssessmentFacade)" as Assessment
  component "learning\nlộ trình, bài học, ôn tập\n(LearningFacade)" as Learning
  component "billing\ngói, đơn, gói lượt\n(BillingFacade)" as Billing
  component "metering\ngiữ chỗ, thu, hoàn lượt\n(MeteringFacade)" as Metering
}

package "speech — chỗ duy nhất chạy nhận dạng" as Speech {
  component "Chấm bài\nQC → Whisper → đặc trưng → Ridge\n(ResponseProcessor)" as Pipeline
  component "Đo một bước bài học\n(LessonRunner)" as Steps
}

queue "Redis — BullMQ, Streams\n(RedisBus)" as Bus
database "MongoDB\naicefr" as DbCore
database "MongoDB\naicefr_learning" as DbLearning
database "MongoDB\naicefr_metering" as DbMetering
storage "Bản ghi âm\nthư mục hoặc S3\n(BlobStore)" as Blobs
cloud "Cổng thanh toán\nStripe, MoMo, VNPay\n(chế độ thử)" as PayExt
node "Prometheus + Grafana\nđọc /metrics" as Mon

User --> GW : HTTPS
GW --> Pages : trang
GW --> Core : API
Pages --> Core : HTTP nội bộ

Assessment --> Bus : gửi bài cần chấm
Learning --> Bus : hỏi đo một bước
Bus --> Pipeline : việc chấm
Bus --> Steps : câu hỏi
Pipeline --> Bus : kết quả
Assessment ..> Metering : giữ chỗ, thu lượt
Billing ..> Metering : cộng gói lượt

Identity --> DbCore
Assessment --> DbCore
Billing --> DbCore
Learning --> DbLearning
Metering --> DbMetering
Assessment --> Blobs : lưu
Pipeline --> Blobs : đọc
Billing --> PayExt : mở thanh toán,\nnhận kết quả có chữ ký
Mon ..> Core
Mon ..> Speech

note right of Bus
  D050: việc chấm qua BullMQ (thử lại 3 lần,
  mỗi bài một việc, bài đánh giá ưu tiên);
  sự kiện qua Redis Streams; hỏi-đáp chờ
  kết quả qua danh sách Redis.
end note

note bottom of DbCore
  Mỗi dịch vụ một database (D051).
  Không dịch vụ nào đọc database
  của dịch vụ khác: hỏi qua facade.
end note
@enduml
