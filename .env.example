# Copy to .env (git-ignored) and fill in only what you use; leave the rest blank.
# demo.sh loads .env when it exists. Elsewhere: set -a; . ./.env; set +a
# Where each key comes from: docs/plan/CAU_HINH_KHOA_BEN_NGOAI.md
# Never commit .env, and never paste a secret into a chat or an issue.

# --- the address people reach this instance at (a real server, or behind a proxy)
AICEFR_PUBLIC_URL=
AICEFR_HTTPS_ONLY=

# --- scoring artifacts (W7-S01): the folder on this machine holding ridge_*.json
# and conformal_*.json. Not in Git: they are Speak & Improve statistics. Each file
# is checked against the SHA-256 pinned in src/aicefr/scoring/artifacts.py.
AICEFR_MODEL_HOST_DIR=../aicefr-models

# --- sign in with Google (D029, D036): an OAuth client of type "Web application"
AICEFR_GOOGLE_CLIENT_ID=
AICEFR_GOOGLE_CLIENT_SECRET=
AICEFR_GOOGLE_DOMAIN=

# --- service plans and payment (D034, D035). Every gateway defaults to its own
# test environment; a gateway that moves real money also needs AICEFR_PAYMENTS_LIVE.
AICEFR_BILLING=
AICEFR_PAYMENT_GATEWAYS=sandbox
AICEFR_PAYMENTS_LIVE=
AICEFR_LICENSE_SECRET=

# Stripe, test mode: sk_test_... (API keys) and whsec_... (webhook endpoint or `stripe listen`)
AICEFR_STRIPE_SECRET_KEY=
AICEFR_STRIPE_WEBHOOK_SECRET=

# MoMo, test environment (test-payment.momo.vn unless AICEFR_MOMO_ENDPOINT says otherwise)
AICEFR_MOMO_PARTNER_CODE=
AICEFR_MOMO_ACCESS_KEY=
AICEFR_MOMO_SECRET_KEY=
AICEFR_MOMO_ENDPOINT=

# VNPay sandbox (sandbox.vnpayment.vn unless AICEFR_VNPAY_URL says otherwise)
AICEFR_VNPAY_TMN_CODE=
AICEFR_VNPAY_HASH_SECRET=
AICEFR_VNPAY_URL=

# --- the services (D043, D044): docker compose refuses to start without these.
# Long random strings, letters and digits only, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
AICEFR_INTERNAL_TOKEN=
AICEFR_GATEWAY_TOKEN=
MONGO_ROOT_PASSWORD=
CORE_DB_PASSWORD=
REDIS_PASSWORD=
# Only with docker-compose.objectstore.yml (D051): the S3 store's keys.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Only with docker-compose.observability.yml (D051): Grafana's admin password.
GRAFANA_PASSWORD=
# Speech: "whisper" for real scoring (downloads ~1.5 GB once); anything else is the fake engine.
AICEFR_ASR=
