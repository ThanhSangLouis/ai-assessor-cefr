# Production .env for one server behind Caddy (D047). Copy to /srv/aicefr/.env ON
# THE SERVER (never commit it, never copy your local .env there) and fill in.
# Step by step: docs/plan/TRIEN_KHAI_VPS.md. Where each external key comes from:
# docs/plan/CAU_HINH_KHOA_BEN_NGOAI.md. Every value below is a placeholder.

# --- compose: plain `docker compose ...` on the server then uses the production override too
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# --- the site. A DNS A record for this name must point at the server before the
# first start: Caddy asks Let's Encrypt for the certificate over ports 80/443.
AICEFR_DOMAIN=cefr.example.org

# docker-compose.prod.yml already sets, for core and web:
#   AICEFR_PUBLIC_URL=https://${AICEFR_DOMAIN}
#   AICEFR_HTTPS_ONLY=1   (cookies marked Secure, HSTS sent)
# so leave these two out here; a value set here is overridden anyway.

# --- the services (D043, D044): docker compose refuses to start without these.
# Long random strings, letters and digits only, a different one for each:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
AICEFR_INTERNAL_TOKEN=change-me-random-hex
AICEFR_GATEWAY_TOKEN=change-me-random-hex
MONGO_ROOT_PASSWORD=change-me-random-hex
CORE_DB_PASSWORD=change-me-random-hex
REDIS_PASSWORD=change-me-random-hex

# --- scoring artifacts (aicefr-models, never in Git). Default ../aicefr-models,
# i.e. /srv/aicefr-models next to /srv/aicefr on the server.
AICEFR_MODEL_HOST_DIR=/srv/aicefr-models

# --- speech recognition. "whisper" for real scoring: downloads ~1.5 GB of model
# once and needs about 6 GB of RAM for the speech container (the compose limit),
# so a server with 8 GB or more. Anything else is the fake recogniser: scores are
# meaningless and the interface says so; enough for a 4 GB server and a demo.
AICEFR_ASR=whisper
AICEFR_FAKE_TRANSCRIPT=

# --- seed accounts (D063): deploy/vps/deploy.sh creates QT-01, GV-01..03 and
# SV-001..010 when they are missing, all with this password (8+ characters, no
# spaces or quotes). Unset = no seeding.
AICEFR_SEED_PASSWORD=

# --- sign in with Google (D029, D036), optional: an OAuth client of type "Web
# application" with https://<AICEFR_DOMAIN>/auth/google/callback as redirect URI.
AICEFR_GOOGLE_CLIENT_ID=
AICEFR_GOOGLE_CLIENT_SECRET=
AICEFR_GOOGLE_DOMAIN=

# --- the upgraded answer (D069, D072): Gemini 3.5 Flash-Lite, free tier. The
# feature stays hidden until the key is set. The cap counts every request in
# Google's day (ends at midnight Pacific), under its free quota of 500; on a
# paid key, set a daily budget in USD instead (prices per million tokens).
AICEFR_COACH_PROVIDER=gemini
AICEFR_COACH_DAILY=5
AICEFR_COACH_GLOBAL_DAILY=475
AICEFR_COACH_DAILY_BUDGET_USD=0
AICEFR_COACH_PRICE_INPUT_USD=0.30
AICEFR_COACH_PRICE_OUTPUT_USD=2.50
# The key from aistudio.google.com/apikey.
AICEFR_GEMINI_API_KEY=
# (a comment after the empty key keeps the secret scanner from reading the
# next line as its value)

# --- service plans and payment (D034, D035). Test environments only: the scoring
# model is licensed for non-commercial research use, so this deployment must not
# take real money. Leave AICEFR_PAYMENTS_LIVE empty.
AICEFR_BILLING=
AICEFR_PAYMENT_GATEWAYS=sandbox
AICEFR_PAYMENTS_LIVE=
AICEFR_LICENSE_SECRET=

# Stripe, test mode only: sk_test_... and whsec_...
AICEFR_STRIPE_SECRET_KEY=
AICEFR_STRIPE_WEBHOOK_SECRET=

# MoMo, test environment
AICEFR_MOMO_PARTNER_CODE=
AICEFR_MOMO_ACCESS_KEY=
AICEFR_MOMO_SECRET_KEY=
AICEFR_MOMO_ENDPOINT=

# VNPay sandbox
AICEFR_VNPAY_TMN_CODE=
AICEFR_VNPAY_HASH_SECRET=
AICEFR_VNPAY_URL=
